    "defaultPrompt": [
      "\u9996\u6b21\u51c6\u5907\u771f\u5b9e\u59d4\u6d3e\u65f6\u8bfb\u53d6\u6216\u590d\u7528 $lean-stack\uff1b\u6309\u8d28\u91cf\u3001\u603b\u6210\u672c\u548c\u65f6\u95f4\u9009\u62e9 gpt-5.6-luna\u3001gpt-6-sol\u3001gpt-5.6-sol\u3001gpt-6-astra\uff0c\u601d\u8003\u7a0b\u5ea6\u4ece medium \u8d77\u3002Luna \u53ea\u505a\u6709\u754c\u8bfb\u53d6\u3001\u7ed3\u6784\u5316\u63d0\u53d6\u548c\u4e8b\u5b9e\u603b\u7ed3\uff1b\u524d\u4e09\u6863\u90fd\u662f\u5e38\u89c4\u5b50\u4ee3\u7406\u8def\u7ebf\uff0c\u53ea\u6709 gpt-6-astra \u662f\u4e13\u5bb6\u8def\u7ebf\uff1bAstra \u4ec5\u5728\u6700\u5f3a\u53ef\u884c gpt-5.6-sol \u4ecd\u6709\u51b3\u5b9a\u6027\u8d28\u91cf\u5dee\u8ddd\u65f6\u4f7f\u7528\uff0cxhigh \u53ea\u662f\u4e0a\u9650\u3002\u6309 live child\u3001\u5177\u540d\u4fdd\u7559 lean_* agent_type\u3001generic \u6216\u8fd0\u884c\u65f6\u89d2\u8272\u7684\u987a\u5e8f\u9009\u8def\uff0c\u4fdd\u7559\u7c7b\u578b\u4f18\u5148\uff1b\u517c\u5bb9\u4fdd\u7559\u7c7b\u578b\u5fc5\u987b\u53ec\u56de\u5e76\u771f\u5b9e\u8c03\u7528\uff0c\u56de\u9000\u5199\u5177\u4f53\u4e0d\u517c\u5bb9\u70b9\u3002\u6bcf\u4e2a\u65b0\u7684 followup_task \u589e\u91cf\u5207\u7247\u91cd\u65b0\u6bd4\u8f83\u5f53\u524d\u6700\u5c0f\u80fd\u529b\u3001\u603b\u8fb9\u9645\u6210\u672c\u548c\u65f6\u95f4\uff1b\u82e5\u5f53\u524d\u8d28\u91cf\u4ecd\u9700 Astra\uff0c\u518d\u72ec\u7acb\u9009\u62e9\u65e7\u7ebf\u7a0b\u6216\u53e6\u4e00\u517c\u5bb9 Astra \u8def\u7ebf\uff0c\u65e7\u7ebf\u7a0b\u4e0a\u4e0b\u6587\u65e0\u8fb9\u9645\u4ef7\u503c\u4e0d\u89e6\u53d1\u964d\u7ea7\u3002\u4efb\u52a1\u5361\u4f20\u4e94\u884c\u771f\u5b9e\u72b6\u6001\uff0c\u9996\u6761\u8fdb\u5c55\u8bf4\u660e\u5c55\u793a\u4e94\u884c\uff0cfinal \u9876\u90e8\u91cd\u590d\u524d\u4e09\u884c\uff1b\u8fd0\u884c\u65f6\u7ecf\u9a8c\u884c\u5199\u201c\u672c\u6b21\u4efb\u52a1\u4e0a\u4e0b\u6587\u201d\u3002\u7ed3\u679c\u91c7\u7528\u540e\u5224\u65ad\u4fdd\u7559\uff1a\u5408\u683c\u72ec\u7acb\u65b0\u80fd\u529b\u65cf\u5fc5\u987b\u5c1d\u8bd5\u4e00\u6b21 ensure\uff0c\u4e0d\u5408\u683c\u8bb0\u5f55\u5177\u4f53\u539f\u56e0\u3002",
      "\u975e\u7b80\u5355\u4e3b\u4efb\u52a1\u5f00\u59cb\u540e\u8bfb\u53d6\u6216\u590d\u7528 $lean-simplify\uff1b\u5f53\u53ef\u9009\u51c6\u5907\u5c06\u5148\u4e8e\u5b9e\u9645\u63a8\u8fdb\u65f6\u53ca\u65f6\u4ecb\u5165\u3002\u5165\u53e3\u5148\u786e\u5b9a\u4ea7\u751f\u9996\u4e2a\u53ef\u9a8c\u8bc1\u7ed3\u679c\u7684\u6700\u77ed\u5b8c\u6574\u8def\u5f84\u3001\u4fdd\u6301\u9879\u548c\u505c\u6b62\u6761\u4ef6\uff1b\u786e\u8ba4\u5f53\u524d\u52a8\u4f5c\u540e\u8bfb\u53d6\u5176\u547d\u4e2d\u5206\u652f\uff0c\u4e0b\u4e00\u6b21\u5de5\u5177\u8c03\u7528\u7acb\u5373\u6267\u884c\u3002\u540c\u4e00\u4efb\u52a1\u53ef\u968f\u5b9e\u9645\u52a8\u4f5c\u4f9d\u6b21\u8bfb\u53d6\u591a\u4e2a\u547d\u4e2d\u5206\u652f\uff0c\u4f46\u4e0d\u9884\u5148\u6279\u91cf\u8bfb\u53d6\u5b8c\u6574 references \u6216 $lean-stack\uff0c\u4e5f\u4e0d\u56e0\u62c6\u5206\u8df3\u8fc7\u540e\u7ee7\u89e6\u53d1\u3002\u63a8\u8fdb\u4e2d\u6301\u7eed\u6d88\u9664\u65e0\u52a9\u4e8e\u7ed3\u679c\u7684\u6b65\u9aa4\u3001\u91cd\u590d\u8bfb\u53d6\u548c\u91cd\u590d\u9a8c\u8bc1\uff1b\u7b80\u5355\u7b54\u590d\u6216\u5355\u4e2a\u786e\u5b9a\u6027\u52a8\u4f5c\u76f4\u63a5\u5b8c\u6210\u3002$lean-simplify \u4e0d\u7b49\u5f85\u6216\u963b\u65ad $lean-stack\u3002"
    ]
  }
